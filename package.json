{
  "name": "parse-audio-metadata",
  "version": "1.3.3",
  "description": "Audio file metadata parser",
  "author": "andriuskv",
  "license": "MIT",
  "type": "module",
  "main": "dist/parseAudioMetadata.js",
  "keywords": [
    "audio",
    "metadata",
    "parser",
    "mp3",
    "flac",
    "opus",
    "ogg",
    "m4a",
    "wav"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andriuskv/parse-audio-metadata.git"
  },
  "scripts": {
    "start": "npm run dist-dev & npm run watch & live-server dist",
    "dist": "rm -rf dist && mkdir dist",
    "dist-dev": "npm run dist && cp src/index.html dist",
    "watch": "rollup -cw",
    "build": "npm run dist && rollup -c --environment production"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "core-js": "^3.42.0",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "live-server": "^1.2.2",
    "rollup": "^4.40.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "browserslist": [
    "last 4 chrome versions",
    "last 4 firefox versions",
    "last 1 and_chr versions",
    "last 1 and_ff versions",
    "last 1 safari versions",
    "last 1 ios_saf versions"
  ]
}
